@model Arbeidstid
@{
    ViewData["Title"] = "Ny arbeidstid-periode";
}

<h1>Ny arbeidstid-periode</h1>

<form asp-action="Create" method="post" class="row row-cols-auto g-2 align-items-end">
    <div class="col">
        <label asp-for="Navn" class="form-label"></label>
        <input asp-for="Navn" class="form-control" placeholder="F.eks. Sommertid" />
    </div>
    <div class="col">
        <label asp-for="TimerPerUke" class="form-label"></label>
        <input asp-for="TimerPerUke" class="form-control" type="number" step="0.5" min="0" max="60" />
    </div>
    <div class="col">
        <label asp-for="FraDato" class="form-label"></label>
        <input asp-for="FraDato" class="form-control" />
    </div>
    <div class="col">
        <button type="submit" class="btn btn-primary">Lagre</button>
    </div>
</form>
