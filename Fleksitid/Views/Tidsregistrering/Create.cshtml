@model TimeEntry
@{
    ViewData["Title"] = "Legg til timer";
}

<h1>Legg til timer</h1>

<form asp-action="Create" method="post" class="row row-cols-auto g-2 align-items-end">
    <div class="col">
        <label asp-for="Date" class="form-label"></label>
        <input asp-for="Date" class="form-control" />
    </div>
    <div class="col">
        <label asp-for="Hours" class="form-label"></label>
        <input asp-for="Hours" class="form-control" type="number" step="0.25" min="0" max="24" />
    </div>
    <div class="col">
        <label asp-for="Note" class="form-label"></label>
        <input asp-for="Note" class="form-control" />
    </div>
    <div class="col">
        <button type="submit" class="btn btn-primary">Lagre</button>
    </div>
</form>