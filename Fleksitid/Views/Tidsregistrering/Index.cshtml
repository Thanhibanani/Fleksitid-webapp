@model List<TimeEntry>
@{
    ViewData["Title"] = "Min tid";
}

<h1>Min tid</h1>

@{
    var apenRegistrering = Model.FirstOrDefault(e => e.EndTime == null && e.StartTime != null);
}

@if (apenRegistrering is not null)
{
    <p>Stemplet inn kl. @apenRegistrering.StartTime?.ToShortTimeString()</p>
    <form asp-action="ClockOut" method="post" class="d-inline">
        <button type="submit" class="btn btn-danger mb-3">Slutt</button>
    </form>
}
else
{
    <form asp-action="ClockIn" method="post" class="d-inline">
        <button type="submit" class="btn btn-success mb-3">Start</button>
    </form>
}

<a asp-action="Create" class="btn btn-primary mb-3">+ Legg til</a>

<table class="table">
    <thead>
        <tr>
            <th>Dato</th>
            <th>Timer</th>
            <th>Notat</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var entry in Model)
        {
            <tr>
                <td>@entry.Date.ToShortDateString()</td>
                <td>@entry.Hours.ToString("0.00")</td>
                <td>@entry.Note</td>
                <td>
                    <form asp-action="Delete" asp-route-id="@entry.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Slett</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
