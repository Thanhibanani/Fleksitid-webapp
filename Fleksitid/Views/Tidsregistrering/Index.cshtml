@model TidsregistreringViewModel
@{
    ViewData["Title"] = "Min tid";
}

<h1>Min tid</h1>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <h6 class="card-subtitle text-muted">Denne uken</h6>
                <p class="fs-4 mb-0">@Model.WeekWorkedHours.ToString("0.##") t</p>
                <small class="text-muted">av @Model.WeeklyContractHours.ToString("0.##") t avtalt</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <h6 class="card-subtitle text-muted">Fleksisaldo (totalt)</h6>
                <p class="fs-4 mb-0 @(Model.TotalFlexBalance < 0 ? "text-danger" : "text-success")">
                    @(Model.TotalFlexBalance >= 0 ? "+" : "")@Model.TotalFlexBalance.ToString("0.##") t
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body d-flex flex-column justify-content-center align-items-center">
                @if (Model.OpenEntry is not null)
                {
                    <p class="mb-2">Stemplet inn kl. @Model.OpenEntry.StartTime</p>
                    <form asp-action="ClockOut" method="post">
                        <button type="submit" class="btn btn-danger btn-lg">Slutt</button>
                    </form>
                }
                else
                {
                    <form asp-action="ClockIn" method="post">
                        <button type="submit" class="btn btn-success btn-lg">Start</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Legg til timer manuelt</h5>
                <form asp-action="AddManual" method="post">
                    <div class="mb-2">
                        <label asp-for="ManualEntry.Date" class="form-label"></label>
                        <input asp-for="ManualEntry.Date" class="form-control" />
                        <span asp-validation-for="ManualEntry.Date" class="text-danger"></span>
                    </div>
                    <div class="mb-2">
                        <label asp-for="ManualEntry.Hours" class="form-label">Antall timer</label>
                        <input asp-for="ManualEntry.Hours" class="form-control" type="number" step="0.25" min="0.25" max="24" />
                        <span asp-validation-for="ManualEntry.Hours" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ManualEntry.Note" class="form-label">Notat (valgfritt)</label>
                        <input asp-for="ManualEntry.Note" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-primary">Legg til timer</button>
                </form>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-body">
                <h5 class="card-title">Registrer sykefravær</h5>
                <form asp-action="AddSickDay" method="post">
                    <div class="row g-2 mb-2">
                        <div class="col">
                            <label asp-for="SickDayEntry.FromDate" class="form-label">Fra</label>
                            <input asp-for="SickDayEntry.FromDate" class="form-control" />
                        </div>
                        <div class="col">
                            <label asp-for="SickDayEntry.ToDate" class="form-label">Til</label>
                            <input asp-for="SickDayEntry.ToDate" class="form-control" />
                        </div>
                    </div>
                    <span asp-validation-for="SickDayEntry.ToDate" class="text-danger"></span>
                    <div class="mb-3">
                        <label asp-for="SickDayEntry.Note" class="form-label">Notat (valgfritt)</label>
                        <input asp-for="SickDayEntry.Note" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-outline-secondary">Registrer sykefravær</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Siste registreringer</h5>
                @if (!Model.RecentEntries.Any())
                {
                    <p class="text-muted">Ingen registreringer ennå.</p>
                }
                else
                {
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Dato</th>
                                <th>Timer</th>
                                <th>Kilde</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in Model.RecentEntries)
                            {
                                <tr>
                                    <td>@entry.Date.ToString("dd.MM.yyyy")</td>
                                    <td>
                                        @if (entry.IsOpen)
                                        {
                                            <span class="badge text-bg-warning">Pågår</span>
                                        }
                                        else
                                        {
                                            @entry.Hours.ToString("0.##")<text> t</text>
                                        }
                                    </td>
                                    <td>@(entry.Source == TimeEntrySource.Stempling ? "Stempling" : "Manuell")</td>
                                    <td>
                                        <form asp-action="DeleteEntry" method="post" onsubmit="return confirm('Slette denne registreringen?');">
                                            <input type="hidden" name="id" value="@entry.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Slett</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Sykefravær</h5>
                @if (!Model.RecentSickDays.Any())
                {
                    <p class="text-muted">Ingen registrert sykefravær.</p>
                }
                else
                {
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Fra</th>
                                <th>Til</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sickDay in Model.RecentSickDays)
                            {
                                <tr>
                                    <td>@sickDay.FromDate.ToString("dd.MM.yyyy")</td>
                                    <td>@sickDay.ToDate.ToString("dd.MM.yyyy")</td>
                                    <td>
                                        <form asp-action="DeleteSickDay" method="post" onsubmit="return confirm('Slette dette sykefraværet?');">
                                            <input type="hidden" name="id" value="@sickDay.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Slett</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>
