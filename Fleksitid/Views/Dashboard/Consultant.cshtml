@model ConsultantDetailsViewModel
@{
    ViewData["Title"] = Model.Consultant.FullName;
}

<h1>@Model.Consultant.FullName</h1>
<p class="text-muted">@Model.Consultant.Email</p>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <h6 class="card-subtitle text-muted">Denne uken</h6>
                <p class="fs-4 mb-0">@Model.Consultant.WeekWorkedHours.ToString("0.##") / @Model.Consultant.WeeklyContractHours.ToString("0.##") t</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <h6 class="card-subtitle text-muted">Fleksisaldo</h6>
                <p class="fs-4 mb-0 @(Model.Consultant.TotalFlexBalance < 0 ? "text-danger" : "text-success")">
                    @(Model.Consultant.TotalFlexBalance >= 0 ? "+" : "")@Model.Consultant.TotalFlexBalance.ToString("0.##") t
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <h6 class="card-subtitle text-muted">Sykedager i år</h6>
                <p class="fs-4 mb-0">@Model.Consultant.SickDaysThisYear</p>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-5">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Arbeidskontrakt</h5>
                @if (!Model.Contracts.Any())
                {
                    <p class="text-muted">Ingen kontrakt registrert ennå.</p>
                }
                else
                {
                    <table class="table table-sm">
                        <thead><tr><th>Timer/uke</th><th>Fra</th><th>Til</th></tr></thead>
                        <tbody>
                            @foreach (var c in Model.Contracts)
                            {
                                <tr>
                                    <td>@c.WeeklyHours.ToString("0.##")</td>
                                    <td>@c.StartDate.ToString("dd.MM.yyyy")</td>
                                    <td>@(c.EndDate?.ToString("dd.MM.yyyy") ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                <hr />
                <h6>Ny/oppdatert kontrakt</h6>
                <form asp-action="AddContract" method="post">
                    <input type="hidden" asp-for="NewContract.UserId" />
                    <div class="mb-2">
                        <label asp-for="NewContract.WeeklyHours" class="form-label">Avtalte timer per uke</label>
                        <input asp-for="NewContract.WeeklyHours" class="form-control" type="number" step="0.5" min="0" max="60" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewContract.StartDate" class="form-label">Gjelder fra</label>
                        <input asp-for="NewContract.StartDate" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-primary">Lagre kontrakt</button>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Sykefravær</h5>
                @if (!Model.SickDays.Any())
                {
                    <p class="text-muted">Ingen registrert sykefravær.</p>
                }
                else
                {
                    <table class="table table-sm">
                        <thead><tr><th>Fra</th><th>Til</th></tr></thead>
                        <tbody>
                            @foreach (var s in Model.SickDays)
                            {
                                <tr>
                                    <td>@s.FromDate.ToString("dd.MM.yyyy")</td>
                                    <td>@s.ToDate.ToString("dd.MM.yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Siste registreringer</h5>
                @if (!Model.Entries.Any())
                {
                    <p class="text-muted">Ingen registreringer ennå.</p>
                }
                else
                {
                    <table class="table table-sm">
                        <thead><tr><th>Dato</th><th>Timer</th><th>Kilde</th><th>Notat</th></tr></thead>
                        <tbody>
                            @foreach (var e in Model.Entries)
                            {
                                <tr>
                                    <td>@e.Date.ToString("dd.MM.yyyy")</td>
                                    <td>@(e.IsOpen ? "Pågår" : e.Hours.ToString("0.##") + " t")</td>
                                    <td>@(e.Source == TimeEntrySource.Stempling ? "Stempling" : "Manuell")</td>
                                    <td>@e.Note</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

<a asp-action="Index" class="btn btn-link mt-3">&larr; Tilbake til oversikten</a>
