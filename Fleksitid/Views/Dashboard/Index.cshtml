@model DashboardViewModel
@{
    ViewData["Title"] = "Oversikt";
}

<h1>Oversikt – @Model.OrganizationName</h1>
<p class="text-muted">
    Organisasjonskode: <strong>@Model.OrgCode</strong> – del denne med nye medarbeidere så de kan registrere seg i virksomheten din.
</p>

@if (!Model.Consultants.Any())
{
    <div class="alert alert-info">
        Ingen medarbeidere har registrert seg i virksomheten ennå. Del organisasjonskoden over med dem.
    </div>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Navn</th>
                <th>Status</th>
                <th>Denne uken</th>
                <th>Fleksisaldo</th>
                <th>Sykedager i år</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Consultants)
            {
                <tr>
                    <td>@c.FullName <div class="text-muted small">@c.Email</div></td>
                    <td>
                        @if (c.IsClockedIn)
                        {
                            <span class="badge text-bg-success">Stemplet inn</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Ikke inne</span>
                        }
                    </td>
                    <td>@c.WeekWorkedHours.ToString("0.##") / @c.WeeklyContractHours.ToString("0.##") t</td>
                    <td class="@(c.TotalFlexBalance < 0 ? "text-danger" : "text-success")">
                        @(c.TotalFlexBalance >= 0 ? "+" : "")@c.TotalFlexBalance.ToString("0.##") t
                    </td>
                    <td>@c.SickDaysThisYear</td>
                    <td>
                        <a asp-action="Consultant" asp-route-id="@c.UserId" class="btn btn-sm btn-outline-primary">Detaljer</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
