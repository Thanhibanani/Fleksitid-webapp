@page
@model RegisterModel
@{
    ViewData["Title"] = "Registrer deg";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-6">
        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <h2>Opprett en ny konto</h2>
            <hr />
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.FullName" class="form-control" autocomplete="name" aria-required="true" placeholder="Ola Nordmann" />
                <label asp-for="Input.FullName">Fullt navn</label>
                <span asp-validation-for="Input.FullName" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email">E-post</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="passord" />
                <label asp-for="Input.Password">Passord</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="passord" />
                <label asp-for="Input.ConfirmPassword">Bekreft passord</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <fieldset class="mb-3">
                <legend class="col-form-label">Jeg registrerer meg som</legend>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="Input.AccountType" id="accountTypeLeder" value="Leder" data-role-toggle />
                    <label class="form-check-label" for="accountTypeLeder">Leder – oppretter en ny virksomhet</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="Input.AccountType" id="accountTypeMedarbeider" value="Medarbeider" data-role-toggle />
                    <label class="form-check-label" for="accountTypeMedarbeider">Medarbeider – blir med i en eksisterende virksomhet</label>
                </div>
                <span asp-validation-for="Input.AccountType" class="text-danger"></span>
            </fieldset>

            <div class="form-floating mb-3" id="organizationNameGroup" hidden>
                <input asp-for="Input.OrganizationName" class="form-control" placeholder="Min Bedrift AS" />
                <label asp-for="Input.OrganizationName">Navn på virksomhet</label>
                <span asp-validation-for="Input.OrganizationName" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3" id="orgCodeGroup" hidden>
                <input asp-for="Input.OrgCode" class="form-control text-uppercase" placeholder="ABC123" />
                <label asp-for="Input.OrgCode">Organisasjonskode fra lederen din</label>
                <span asp-validation-for="Input.OrgCode" class="text-danger"></span>
            </div>

            <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Registrer</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var leder = document.getElementById('accountTypeLeder');
            var medarbeider = document.getElementById('accountTypeMedarbeider');
            var orgNameGroup = document.getElementById('organizationNameGroup');
            var orgCodeGroup = document.getElementById('orgCodeGroup');

            function update() {
                orgNameGroup.hidden = !leder.checked;
                orgCodeGroup.hidden = !medarbeider.checked;
            }

            leder.addEventListener('change', update);
            medarbeider.addEventListener('change', update);
            update();
        })();
    </script>
}
